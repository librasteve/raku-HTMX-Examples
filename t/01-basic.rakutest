use Test;
use HTML::Functional;

is h1('text', :class<jumbotron>).chomp, "\n<h1 class=\"jumbotron\">text</h1>",        'h1';

is h1(:class<doobie>).chomp, "\n<h1 class=\"doobie\"></h1>",                          'empty';

is div(:class<jumbotron>, 'xx').chomp, "\n<div class=\"jumbotron\">xx</div>",         'regular';

is hr, "\n<hr />",                                                                  'singluar';


done-testing;
